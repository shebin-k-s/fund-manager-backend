PORT=5000

# Database — either DB_URL or the individual settings
# DB_URL=postgresql://user:password@localhost:5432/fund_manager
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=fund_manager

FRONTEND_URL=http://localhost:8080

JWT_SECRET=
REFRESH_SECRET=

# Time-based access key: valid key = PREFIX + HH + MM (IST) + SUFFIX
PREFIX=
SUFFIX=
APP_ACCESS_KEY=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google Drive backup (Backup & restore page). Create an OAuth client at console.cloud.google.com
# (APIs & Services → Credentials → Web application) with this redirect URI:
#   <BACKEND_URL>/api/v1/backup-hooks/drive-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public address of this backend (no trailing slash), e.g. https://fund-manager-api.onrender.com
BACKEND_URL=http://localhost:5000
# 16+ random characters: encrypts the stored Google key. Changing it means reconnecting Drive.
BACKUP_SECRET=
# 16+ random characters: shared key the daily scheduler sends in the x-backup-key header.
BACKUP_CRON_KEY=
